      "random_seed": 6011
    },
    {
      "case_id": "latin-012",
      "category": "latin_abbreviation",
      "source_text": "MCPから利用できる道具を調べて。",
      "random_seed": 6012
    },
    {
      "case_id": "spatial-001",
      "category": "spatial",
      "source_text": "机の右側には何がありますか。",
      "random_seed": 7001
    },
    {
      "case_id": "spatial-002",
      "category": "spatial",
      "source_text": "ドアの左にある箱を教えて。",
      "random_seed": 7002
    },
    {
      "case_id": "spatial-003",
      "category": "spatial",
      "source_text": "私の前に人は立っていますか。",
      "random_seed": 7003
    },
    {
      "case_id": "spatial-004",
      "category": "spatial",
      "source_text": "椅子の後ろに回り込める？",
      "random_seed": 7004
    },
    {
      "case_id": "spatial-005",
      "category": "spatial",
      "source_text": "棚と壁の間に通れる場所はある？",
      "random_seed": 7005
    },
    {
      "case_id": "spatial-006",
      "category": "spatial",
      "source_text": "一番近い出口はどちらですか。",
      "random_seed": 7006
    },
    {
      "case_id": "spatial-007",
      "category": "spatial",
      "source_text": "赤い箱の上に何が置いてある？",
      "random_seed": 7007
    },
    {
      "case_id": "spatial-008",
      "category": "spatial",
      "source_text": "青いかごの下を確認して。",
      "random_seed": 7008
    },
    {
      "case_id": "spatial-009",
      "category": "spatial",
      "source_text": "現在地から受付までの向きを教えて。",
      "random_seed": 7009
    },
    {
      "case_id": "spatial-010",
      "category": "spatial",
      "source_text": "廊下の突き当たりで右を向いて。",
      "random_seed": 7010
    },
    {
      "case_id": "spatial-011",
      "category": "spatial",
      "source_text": "人と荷物のどちらが手前にある？",
      "random_seed": 7011
    },
    {
      "case_id": "spatial-012",
      "category": "spatial",
      "source_text": "窓から最も遠い椅子を探して。",
      "random_seed": 7012
    },
    {
      "case_id": "robot-001",
      "category": "robot_instruction",
      "source_text": "その場で停止して。",
      "random_seed": 8001
    },
    {
      "case_id": "robot-002",
      "category": "robot_instruction",
      "source_text": "前方の安全を確認してから進んで。",
      "random_seed": 8002
    },
    {
      "case_id": "robot-003",
      "category": "robot_instruction",
      "source_text": "ゆっくり右を向いて。",
      "random_seed": 8003
    },
    {
      "case_id": "robot-004",
      "category": "robot_instruction",
      "source_text": "左側の通路を調べて。",
      "random_seed": 8004
    },
    {
      "case_id": "robot-005",
      "category": "robot_instruction",
      "source_text": "机の手前まで移動して。",
      "random_seed": 8005
    },
    {
      "case_id": "robot-006",
      "category": "robot_instruction",
      "source_text": "人が通り過ぎるまで待機して。",
      "random_seed": 8006
    },
    {
      "case_id": "robot-007",
      "category": "robot_instruction",
      "source_text": "カメラで周囲を見回して。",
      "random_seed": 8007
    },
    {
      "case_id": "robot-008",
      "category": "robot_instruction",
      "source_text": "目的地までの経路を確認して。",
      "random_seed": 8008
    },
    {
      "case_id": "robot-009",
      "category": "robot_instruction",
      "source_text": "障害物があれば止まって知らせて。",
      "random_seed": 8009
    },
    {
      "case_id": "robot-010",
      "category": "robot_instruction",
      "source_text": "現在の作業を中断して戻ってきて。",
      "random_seed": 8010
    },
    {
      "case_id": "robot-011",
      "category": "robot_instruction",
      "source_text": "音を鳴らして準備完了を知らせて。",
      "random_seed": 8011
    },
    {
      "case_id": "robot-012",
      "category": "robot_instruction",
      "source_text": "センサーが復帰するまで動かないで。",
      "random_seed": 8012
    },
    {
      "case_id": "long-001",
      "category": "long",
      "source_text": "今から部屋の様子を確認するね。まず正面を見て、そのあと左右を順番に調べて、通れる場所があるかを伝えるよ。",
      "random_seed": 9001
    },
    {
      "case_id": "long-002",
      "category": "long",
      "source_text": "さっき頼まれた作業はまだ終わっていないよ。途中でセンサーが止まったから、安全を確認してから続きを再開するね。",
      "random_seed": 9002
    },
    {
      "case_id": "long-003",
      "category": "long",
      "source_text": "受付までの道を説明するね。この廊下をまっすぐ進み、突き当たりを右に曲がると、左手に案内板が見えるよ。",
      "random_seed": 9003
    },
    {
      "case_id": "long-004",
      "category": "long",
      "source_text": "今見えている範囲には、人が一人と椅子が二脚、それから机の上に小さな赤い箱が置いてあるよ。",
      "random_seed": 9004
    },
    {
      "case_id": "long-005",
      "category": "long",
      "source_text": "音声が少し聞き取りにくかったよ。大事な部分を間違えたくないから、最後のお願いだけもう一度ゆっくり話してくれる？",
      "random_seed": 9005
    },
    {
      "case_id": "long-006",
      "category": "long",
      "source_text": "確認したところ、通信は正常で、カメラも動いているよ。ただし前方の距離センサーだけ応答が遅いので、今は移動しないね。",
      "random_seed": 9006
    },
    {
      "case_id": "long-007",
      "category": "long",
      "source_text": "質問に答える前に、現在地と周囲の物の位置を確認するよ。結果がまとまったら、なるべく短くわかりやすく説明するね。",
      "random_seed": 9007
    },
    {
      "case_id": "long-008",
      "category": "long",
      "source_text": "作業を始める前に、進む方向と停止する場所を確認したいな。目的地は奥の棚の前で合っているか、教えてくれる？",
      "random_seed": 9008
    },
    {
      "case_id": "long-009",
      "category": "long",
      "source_text": "今の説明をまとめるね。最初に音声を聞き取り、必要なら周囲を確認して、その結果を使って次の行動を決めるよ。",
      "random_seed": 9009
    },
    {
      "case_id": "long-010",
      "category": "long",
      "source_text": "人が近くにいるときは速度を落とし、進路がふさがれていたらその場で止まるよ。安全が確認できるまで勝手には進まないよ。",
      "random_seed": 9010
    },
    {
      "case_id": "long-011",
      "category": "long",
      "source_text": "返事をしながら調べられることは先に伝えるね。少し時間がかかる確認については、途中の状況も短く知らせるようにするよ。",
      "random_seed": 9011
    },
    {
      "case_id": "long-012",
      "category": "long",
      "source_text": "これまでの会話では、音声の速さと聞き取りやすさを確認してきたね。次は長い対話でも内容を忘れないか試してみよう。",
      "random_seed": 9012
    }
  ],
  "cancel_case": {
    "case_id": "cancel-001",
    "source_text": "アスパ、長い説明は止めて。今すぐ発話を中断して。",
    "random_seed": 4294967295
  }
}
