    {
      "case_id": "conversation-001",
      "category": "conversation",
      "source_text": "今日は何を手伝えばいいかな。",
      "random_seed": 3001
    },
    {
      "case_id": "conversation-002",
      "category": "conversation",
      "source_text": "さっきの話をもう少し詳しく教えて。",
      "random_seed": 3002
    },
    {
      "case_id": "conversation-003",
      "category": "conversation",
      "source_text": "それなら、先に状況を確認してみるね。",
      "random_seed": 3003
    },
    {
      "case_id": "conversation-004",
      "category": "conversation",
      "source_text": "今の説明でわかりにくいところはあった？",
      "random_seed": 3004
    },
    {
      "case_id": "conversation-005",
      "category": "conversation",
      "source_text": "急がなくていいから、順番に話してね。",
      "random_seed": 3005
    },
    {
      "case_id": "conversation-006",
      "category": "conversation",
      "source_text": "その考え方はいいね、続きを聞かせて。",
      "random_seed": 3006
    },
    {
      "case_id": "conversation-007",
      "category": "conversation",
      "source_text": "今は答えを急がずに、一緒に整理しよう。",
      "random_seed": 3007
    },
    {
      "case_id": "conversation-008",
      "category": "conversation",
      "source_text": "前に話した内容も踏まえて考えてみるよ。",
      "random_seed": 3008
    },
    {
      "case_id": "conversation-009",
      "category": "conversation",
      "source_text": "聞き取れなかったから、もう一回言ってくれる？",
      "random_seed": 3009
    },
    {
      "case_id": "conversation-010",
      "category": "conversation",
      "source_text": "今のところ、特に問題は見つかっていないよ。",
      "random_seed": 3010
    },
    {
      "case_id": "conversation-011",
      "category": "conversation",
      "source_text": "それは面白いね、どうしてそう思ったの？",
      "random_seed": 3011
    },
    {
      "case_id": "conversation-012",
      "category": "conversation",
      "source_text": "準備ができたら、いつでも声をかけてね。",
      "random_seed": 3012
    },
    {
      "case_id": "punctuation-001",
      "category": "punctuation",
      "source_text": "「本当に大丈夫？」と、もう一度たずねた。",
      "random_seed": 4001
    },
    {
      "case_id": "punctuation-002",
      "category": "punctuation",
      "source_text": "注意！前方に障害物があります。",
      "random_seed": 4002
    },
    {
      "case_id": "punctuation-003",
      "category": "punctuation",
      "source_text": "右、左、中央の順に確認する。",
      "random_seed": 4003
    },
    {
      "case_id": "punctuation-004",
      "category": "punctuation",
      "source_text": "結果は、成功・保留・失敗の三種類です。",
      "random_seed": 4004
    },
    {
      "case_id": "punctuation-005",
      "category": "punctuation",
      "source_text": "次の項目【音声】【映像】【位置】を確認する。",
      "random_seed": 4005
    },
    {
      "case_id": "punctuation-006",
      "category": "punctuation",
      "source_text": "うーん……少しだけ待ってね。",
      "random_seed": 4006
    },
    {
      "case_id": "punctuation-007",
      "category": "punctuation",
      "source_text": "確認したいのは、速度・向き・距離です。",
      "random_seed": 4007
    },
    {
      "case_id": "punctuation-008",
      "category": "punctuation",
      "source_text": "「止まって」と言われたら、すぐに停止する。",
      "random_seed": 4008
    },
    {
      "case_id": "punctuation-009",
      "category": "punctuation",
      "source_text": "準備よし、通信よし、では始めよう！",
      "random_seed": 4009
    },
    {
      "case_id": "punctuation-010",
      "category": "punctuation",
      "source_text": "回答は「はい」か「いいえ」でお願い。",
      "random_seed": 4010
    },
    {
      "case_id": "punctuation-011",
      "category": "punctuation",
      "source_text": "作業前（安全確認）、作業中（監視）、作業後（停止）を守る。",
      "random_seed": 4011
    },
    {
      "case_id": "punctuation-012",
      "category": "punctuation",
      "source_text": "質問は三つあります。一つ目は場所、二つ目は時間、三つ目は理由です。",
      "random_seed": 4012
    },
    {
      "case_id": "number-unit-001",
      "category": "number_unit",
      "source_text": "前へ3メートル進む。",
      "random_seed": 5001
    },
    {
      "case_id": "number-unit-002",
      "category": "number_unit",
      "source_text": "壁まで20センチです。",
      "random_seed": 5002
    },
    {
      "case_id": "number-unit-003",
      "category": "number_unit",
      "source_text": "10秒後にもう一度確認する。",
      "random_seed": 5003
    },
    {
      "case_id": "number-unit-004",
      "category": "number_unit",
      "source_text": "音声は48キロヘルツで処理する。",
      "random_seed": 5004
    },
    {
      "case_id": "number-unit-005",
      "category": "number_unit",
      "source_text": "空きメモリは24ギガバイトです。",
      "random_seed": 5005
    },
    {
      "case_id": "number-unit-006",
      "category": "number_unit",
      "source_text": "開始時刻は12時30分です。",
      "random_seed": 5006
    },
    {
      "case_id": "number-unit-007",
      "category": "number_unit",
      "source_text": "ロボットを2台ずつ確認する。",
      "random_seed": 5007
    },
    {
      "case_id": "number-unit-008",
      "category": "number_unit",
      "source_text": "右へ120度回転する。",
      "random_seed": 5008
    },
    {
      "case_id": "number-unit-009",
      "category": "number_unit",
      "source_text": "電池残量は5パーセントです。",
      "random_seed": 5009
    },
    {
      "case_id": "number-unit-010",
      "category": "number_unit",
      "source_text": "7月30日の午後に試験する。",
      "random_seed": 5010
