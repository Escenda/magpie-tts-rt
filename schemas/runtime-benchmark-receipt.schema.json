            {
              "type": "null"
            }
          ]
        },
        "cancel_call_ms": {
          "$ref": "#/$defs/nonnegative_number"
        },
        "cancel_latency_ms": {
          "$ref": "#/$defs/nonnegative_number"
        },
        "audio_samples_before_cancel": {
          "type": "integer",
          "minimum": 0
        },
        "post_cancel_lease_count": {
          "type": "integer",
          "minimum": 0
        },
