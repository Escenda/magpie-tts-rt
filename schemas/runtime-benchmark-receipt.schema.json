    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "required_injection_points",
        "results"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "required_injection_points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "immediately_after_request_start"
            },
            {
              "const": "after_first_audio_chunk"
            },
            {
              "const": "after_second_audio_chunk"
            }
          ],
          "items": false
        },
        "results": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/cancel_result"
                },
                {
                  "properties": {
                    "injection_point": {
                      "const": "immediately_after_request_start"
                    },
                    "audio_chunks_before_cancel": {
                      "const": 0
                    },
                    "first_audio_ms": {
                      "type": "null"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/cancel_result"
                },
                {
                  "properties": {
                    "injection_point": {
                      "const": "after_first_audio_chunk"
                    },
                    "audio_chunks_before_cancel": {
                      "const": 1
                    },
                    "first_audio_ms": {
                      "$ref": "#/$defs/nonnegative_number"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/cancel_result"
                },
                {
                  "properties": {
                    "injection_point": {
                      "const": "after_second_audio_chunk"
                    },
                    "audio_chunks_before_cancel": {
                      "const": 2
                    },
                    "first_audio_ms": {
                      "$ref": "#/$defs/nonnegative_number"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
