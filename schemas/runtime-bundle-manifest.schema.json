{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Escenda/magpie-tts-rt/schemas/runtime-bundle-manifest.schema.json",
  "title": "MagpieTTS-RT runtime bundle manifest",
  "description": "Fail-closed contract for one immutable TensorRT runtime bundle. Runtime code must also enforce the cross-field invariants implemented by the C++ parser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "created_at_utc",
    "runtime",
    "artifacts",
    "classifier_free_guidance",
    "engines",
    "kv_cache",
    "alignment",
    "sampling",
    "local_ar",
    "codec",
    "limits",
    "golden_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeFingerprint"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "classifier_free_guidance": {
      "$ref": "#/$defs/classifierFreeGuidance"
    },
    "engines": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/engine"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "text_encoder"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "main_decoder_prefill"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "main_decoder_step"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "local_ar_16"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "nanocodec_initial_4"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "nanocodec_steady_8"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "nanocodec_tail_1_8"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "kv_cache": {
      "$ref": "#/$defs/kvCache"
    },
    "alignment": {
      "$ref": "#/$defs/alignment"
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "local_ar": {
      "$ref": "#/$defs/localAr"
    },
    "codec": {
      "$ref": "#/$defs/codec"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "golden_receipt": {
      "$ref": "#/$defs/goldenReceipt"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001F\\u007F]).+$"
    },
    "numericVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+(?:[-+][A-Za-z0-9._-]+)?$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "positiveUint32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "positiveUint64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "dtype": {
      "enum": [
        "fp32",
        "fp16",
        "bf16",
        "int64",
        "int32",
        "int8",
        "uint8",
        "bool"
      ]
    },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/positiveUint64"
        }
      }
    },
    "runtimeFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_name",
        "os_version",
        "architecture",
        "endianness",
        "cuda_version",
        "tensorrt_version",
        "driver_version",
        "gpu_name",
        "gpu_compute_capability",
        "plugin_abi_version"
      ],
      "properties": {
        "os_name": {
          "$ref": "#/$defs/identifier"
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "enum": ["aarch64", "x86_64"]
        },
        "endianness": {
          "enum": ["little", "big"]
        },
        "cuda_version": {
          "$ref": "#/$defs/numericVersion"
        },
        "tensorrt_version": {
          "$ref": "#/$defs/numericVersion"
        },
        "driver_version": {
          "$ref": "#/$defs/numericVersion"
        },
        "gpu_name": {
          "type": "string",
          "minLength": 1
        },
        "gpu_compute_capability": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "plugin_abi_version": {
          "$ref": "#/$defs/positiveUint32"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "export", "tokenizer", "plugin"],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "revision", "file"],
          "properties": {
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "$ref": "#/$defs/fileArtifact"
            }
          }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "source_revision",
            "voice_id",
            "baked_context_length",
            "baked_context_sha256",
            "audio_bos_baked",
            "file"
          ],
          "properties": {
            "format": {
              "$ref": "#/$defs/identifier"
            },
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "voice_id": {
              "const": "sofia"
            },
            "baked_context_length": {
              "const": 217
            },
            "baked_context_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "audio_bos_baked": {
              "const": true
            },
            "file": {
              "$ref": "#/$defs/fileArtifact"
            }
          }
        },
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "vocabulary_size", "file"],
          "properties": {
            "kind": {
              "$ref": "#/$defs/identifier"
            },
            "vocabulary_size": {
              "$ref": "#/$defs/positiveUint32"
            },
            "file": {
              "$ref": "#/$defs/fileArtifact"
            }
          }
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "abi_version", "file"],
          "properties": {
            "name": {
              "$ref": "#/$defs/identifier"
            },
            "abi_version": {
              "$ref": "#/$defs/positiveUint32"
            },
            "file": {
              "$ref": "#/$defs/fileArtifact"
            }
          }
        }
      }
    },
    "classifierFreeGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_order",
        "conditional_row_index",
        "conditional_condition_source",
        "conditional_mask_source",
        "unconditional_row_index",
        "unconditional_condition_source",
        "unconditional_mask_source"
      ],
      "properties": {
        "row_order": {
          "const": "conditional_then_unconditional"
        },
        "conditional_row_index": {
          "const": 0
        },
        "conditional_condition_source": {
          "const": "text_encoder_output"
        },
        "conditional_mask_source": {
          "const": "text_mask"
        },
        "unconditional_row_index": {
          "const": 1
        },
        "unconditional_condition_source": {
          "const": "all_zero"
        },
        "unconditional_mask_source": {
          "const": "all_false"
        }
      }
    },
    "declaredShape": {
      "type": "array",
      "items": {
        "type": "integer",
        "anyOf": [
          {
            "const": -1
          },
          {
            "minimum": 1
          }
        ]
      }
    },
    "concreteShape": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "dtype": {
          "$ref": "#/$defs/dtype"
        },
        "shape": {
          "$ref": "#/$defs/declaredShape"
        }
      }
    },
    "shapeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tensor_name", "min", "opt", "max"],
      "properties": {
        "tensor_name": {
          "$ref": "#/$defs/identifier"
        },
        "min": {
          "$ref": "#/$defs/concreteShape"
        },
        "opt": {
          "$ref": "#/$defs/concreteShape"
        },
        "max": {
          "$ref": "#/$defs/concreteShape"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_shapes"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "input_shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shapeRange"
          }
        }
      }
    },
    "textEncoderProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_shapes"],
      "properties": {
        "name": {
          "const": "text_1_512"
        },
        "input_shapes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "const": {
                  "tensor_name": "text_token_ids",
                  "min": [1, 1],
                  "opt": [1, 64],
                  "max": [1, 512]
                }
              },
              {
                "const": {
                  "tensor_name": "text_mask",
                  "min": [1, 1],
                  "opt": [1, 64],
                  "max": [1, 512]
                }
              }
            ]
          }
        }
      }
    },
    "prefillProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_shapes"],
      "properties": {
        "name": {
          "const": "text_1_512"
        },
        "input_shapes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "const": {
                  "tensor_name": "condition",
                  "min": [2, 1, 768],
                  "opt": [2, 64, 768],
                  "max": [2, 512, 768]
                }
              },
              {
                "const": {
                  "tensor_name": "condition_mask",
                  "min": [2, 1],
                  "opt": [2, 64],
                  "max": [2, 512]
                }
              }
            ]
          }
        }
      }
    },
    "stepProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_shapes"],
      "properties": {
        "name": {
          "const": "text_1_512"
        },
        "input_shapes": {
          "type": "array",
          "minItems": 25,
          "maxItems": 25,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "const": {
                  "tensor_name": "alignment_prior",
                  "min": [2, 1, 1],
                  "opt": [2, 1, 64],
                  "max": [2, 1, 512]
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["tensor_name", "min", "opt", "max"],
                "properties": {
                  "tensor_name": {
                    "type": "string",
                    "pattern": "^step_cross_(key|value)_in_([0-9]|1[01])$"
                  },
                  "min": {
                    "const": [2, 1, 1, 128]
                  },
                  "opt": {
                    "const": [2, 64, 1, 128]
                  },
                  "max": {
                    "const": [2, 512, 1, 128]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "fixedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_shapes"],
      "properties": {
        "name": {
          "const": "fixed"
        },
        "input_shapes": {
          "const": []
        }
      }
    },
    "tailProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_shapes"],
      "properties": {
        "name": {
          "const": "tail_1_8"
        },
        "input_shapes": {
          "const": [
            {
              "tensor_name": "codec_tokens",
              "min": [1, 8, 1],
              "opt": [1, 8, 4],
              "max": [1, 8, 8]
            }
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "file", "inputs", "outputs", "profiles"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "enum": [
            "text_encoder",
            "main_decoder_prefill",
            "main_decoder_step",
            "local_ar_16",
            "nanocodec_initial_4",
            "nanocodec_steady_8",
            "nanocodec_tail_1_8"
          ]
        },
        "file": {
          "$ref": "#/$defs/fileArtifact"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tensor"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tensor"
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profile"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["role"],
            "properties": {
              "role": {
                "const": "text_encoder"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 2,
                "allOf": [
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "text_token_ids"},
                        "dtype": {"const": "int64"},
                        "shape": {"const": [1, -1]}
                      }
                    }
                  },
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "text_mask"},
                        "dtype": {"const": "bool"},
                        "shape": {"const": [1, -1]}
                      }
                    }
                  }
                ]
              },
              "outputs": {
                "minItems": 1,
                "maxItems": 1,
                "contains": {
                  "required": ["name", "dtype", "shape"],
                  "properties": {
                    "name": {"const": "text_condition"},
                    "dtype": {"const": "bf16"},
                    "shape": {"const": [1, -1, 768]}
                  }
                }
              },
              "profiles": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/textEncoderProfile"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["role"],
            "properties": {
              "role": {
                "const": "main_decoder_prefill"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 2,
                "maxItems": 2,
                "allOf": [
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "condition"},
                        "dtype": {"const": "bf16"},
                        "shape": {"const": [2, -1, 768]}
                      }
                    }
                  },
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "condition_mask"},
                        "dtype": {"const": "bool"},
                        "shape": {"const": [2, -1]}
                      }
                    }
                  }
                ]
              },
              "outputs": {
                "minItems": 62,
                "maxItems": 62,
                "allOf": [
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "last_hidden"},
                        "dtype": {"const": "bf16"},
                        "shape": {"const": [2, 1, 768]}
                      }
                    }
                  },
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "alignment"},
                        "dtype": {"const": "bf16"},
                        "shape": {"const": [2, -1]}
                      }
                    }
                  }
                ]
              },
              "profiles": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/prefillProfile"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["role"],
            "properties": {
              "role": {
                "const": "main_decoder_step"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 63,
                "maxItems": 63,
                "allOf": [
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "previous_codec_tokens"},
                        "dtype": {"const": "int64"},
                        "shape": {"const": [1, 8, 2]}
                      }
                    }
                  },
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "position"},
                        "dtype": {"const": "int64"},
                        "shape": {"const": []}
                      }
                    }
                  },
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "alignment_prior"},
                        "dtype": {"const": "bf16"},
                        "shape": {"const": [2, 1, -1]}
                      }
                    }
                  }
                ]
              },
              "outputs": {
                "minItems": 38,
                "maxItems": 38,
                "allOf": [
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "decoder_hidden"},
                        "dtype": {"const": "bf16"},
                        "shape": {"const": [2, 768]}
                      }
                    }
                  },
                  {
                    "contains": {
                      "required": ["name", "dtype", "shape"],
                      "properties": {
                        "name": {"const": "alignment"},
                        "dtype": {"const": "bf16"},
                        "shape": {"const": [2, -1]}
                      }
                    }
                  }
                ]
              },
              "profiles": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/stepProfile"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["role"],
            "properties": {
              "role": {
                "const": "local_ar_16"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 6,
                "maxItems": 6,
                "allOf": [
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "decoder_hidden"}, "dtype": {"const": "bf16"}, "shape": {"const": [2, 768]}}}},
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "unfinished"}, "dtype": {"const": "bool"}, "shape": {"const": [1]}}}},
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "finished"}, "dtype": {"const": "bool"}, "shape": {"const": [1]}}}},
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "forbid_eos"}, "dtype": {"const": "bool"}, "shape": {"const": [1]}}}},
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "rng_seed"}, "dtype": {"const": "int64"}, "shape": {"const": [1]}}}},
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "rng_counter"}, "dtype": {"const": "int64"}, "shape": {"const": [1]}}}}
                ]
              },
              "outputs": {
                "minItems": 4,
                "maxItems": 4,
                "allOf": [
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "codec_tokens"}, "dtype": {"const": "int64"}, "shape": {"const": [1, 8, 2]}}}},
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "updated_rng_counter"}, "dtype": {"const": "int64"}, "shape": {"const": [1]}}}},
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "invalid_rows"}, "dtype": {"const": "int32"}, "shape": {"const": [1]}}}},
                  {"contains": {"required": ["name", "dtype", "shape"], "properties": {"name": {"const": "end_frame_index"}, "dtype": {"const": "int32"}, "shape": {"const": [1]}}}}
                ]
              },
